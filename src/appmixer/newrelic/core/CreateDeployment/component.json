{
    "name": "appmixer.newrelic.core.CreateDeployment",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Record a new deployment for an application in New Relic.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:newrelic"
    },
    "quota": {
        "manager": "appmixer:newrelic",
        "resources": "api.requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "applicationId": {
                        "type": "integer"
                    },
                    "revision": {
                        "type": "string"
                    },
                    "changelog": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "user": {
                        "type": "string"
                    }
                },
                "required": ["applicationId", "revision"]
            },
            "inspector": {
                "inputs": {
                    "applicationId": {
                        "type": "number",
                        "label": "Application ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the application"
                    },
                    "revision": {
                        "type": "text",
                        "label": "Revision",
                        "index": 2,
                        "tooltip": "A string identifying the deployed version (e.g., git commit hash, version number)"
                    },
                    "changelog": {
                        "type": "textarea",
                        "label": "Changelog",
                        "index": 3,
                        "tooltip": "A summary of the changes included in this deployment"
                    },
                    "description": {
                        "type": "textarea",
                        "label": "Description",
                        "index": 4,
                        "tooltip": "A description of the deployment"
                    },
                    "user": {
                        "type": "text",
                        "label": "User",
                        "index": 5,
                        "tooltip": "The user who initiated the deployment"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Deployment ID", "value": "id" },
                { "label": "Revision", "value": "revision" },
                { "label": "Changelog", "value": "changelog" },
                { "label": "Description", "value": "description" },
                { "label": "User", "value": "user" },
                { "label": "Timestamp", "value": "timestamp" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
