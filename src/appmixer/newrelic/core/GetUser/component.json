{
    "name": "appmixer.newrelic.core.GetUser",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get details of a specific user by their ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:newrelic"
    },
    "quota": {
        "manager": "appmixer:newrelic",
        "resources": "api.requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "userId": {
                        "type": "integer"
                    }
                },
                "required": ["userId"]
            },
            "inspector": {
                "inputs": {
                    "userId": {
                        "type": "number",
                        "label": "User ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the user"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "User ID", "value": "id" },
                { "label": "First Name", "value": "first_name" },
                { "label": "Last Name", "value": "last_name" },
                { "label": "Email", "value": "email" },
                { "label": "Role", "value": "role" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
