{
    "name": "appmixer.newrelic.core.GetServer",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Get details of a specific server by its ID.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:newrelic"
    },
    "quota": {
        "manager": "appmixer:newrelic",
        "resources": "api.requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "serverId": {
                        "type": "integer"
                    }
                },
                "required": ["serverId"]
            },
            "inspector": {
                "inputs": {
                    "serverId": {
                        "type": "number",
                        "label": "Server ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the server"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Server ID", "value": "id" },
                { "label": "Name", "value": "name" },
                { "label": "Host", "value": "host" },
                { "label": "Health Status", "value": "health_status" },
                { "label": "Reporting", "value": "reporting" },
                { "label": "Last Reported At", "value": "last_reported_at" },
                { "label": "Summary", "value": "summary" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
