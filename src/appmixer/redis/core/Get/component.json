{
    "name": "appmixer.redis.core.Get",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a value from Redis by key.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:redis"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    }
                },
                "required": ["key"]
            },
            "inspector": {
                "inputs": {
                    "key": {
                        "type": "text",
                        "index": 1,
                        "label": "Key",
                        "tooltip": "The key to retrieve"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Key",
                    "value": "key"
                },
                {
                    "label": "Value",
                    "value": "value"
                },
                {
                    "label": "Exists",
                    "value": "exists"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
