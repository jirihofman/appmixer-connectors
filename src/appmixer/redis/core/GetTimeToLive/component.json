{
    "name": "appmixer.redis.core.GetTimeToLive",
    "description": "Returns the remaining time to live of a key.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:redis"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    }
                },
                "required": [
                    "key"
                ]
            },
            "inspector": {
                "inputs": {
                    "key": {
                        "type": "text",
                        "label": "Key",
                        "index": 1,
                        "tooltip": "The key to check."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "TTL",
                    "value": "ttl"
                },
                {
                    "label": "Key",
                    "value": "key"
                },
                {
                    "label": "Has Expiration",
                    "value": "hasExpiration"
                }
            ]
        }
    ]
}
