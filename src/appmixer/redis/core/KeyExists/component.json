{
    "name": "appmixer.redis.core.KeyExists",
    "description": "Determines whether one or more keys exist.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:redis"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    }
                },
                "required": [
                    "key"
                ]
            },
            "inspector": {
                "inputs": {
                    "key": {
                        "type": "text",
                        "label": "Key",
                        "index": 1,
                        "tooltip": "The key(s) to check (comma-separated)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Count",
                    "value": "count"
                },
                {
                    "label": "Exists",
                    "value": "exists"
                },
                {
                    "label": "Key",
                    "value": "key"
                }
            ]
        }
    ]
}
