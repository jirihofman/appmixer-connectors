{
    "name": "appmixer.redis.core.Keys",
    "author": "Appmixer <info@appmixer.com>",
    "description": "List keys in Redis matching a pattern. WARNING: Use with caution in production as it can be slow.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:redis"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "pattern": {
                        "type": "string"
                    }
                },
                "required": ["pattern"]
            },
            "inspector": {
                "inputs": {
                    "pattern": {
                        "type": "text",
                        "index": 1,
                        "label": "Pattern",
                        "tooltip": "Pattern to match keys (e.g., '*' for all, 'user:*' for keys starting with 'user:')"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Keys",
                    "value": "keys",
                    "schema": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                {
                    "label": "Count",
                    "value": "count"
                }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
