{
    "name": "appmixer.redis.core.ListPopFirst",
    "description": "Removes and returns the first element(s) from a list.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:redis"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "count": {
                        "type": "integer"
                    }
                },
                "required": [
                    "key"
                ]
            },
            "inspector": {
                "inputs": {
                    "key": {
                        "type": "text",
                        "label": "Key",
                        "index": 1,
                        "tooltip": "The list key."
                    },
                    "count": {
                        "type": "number",
                        "label": "Count",
                        "index": 2,
                        "tooltip": "Number of elements to pop (default 1)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Element",
                    "value": "element"
                },
                {
                    "label": "Key",
                    "value": "key"
                },
                {
                    "label": "Exists",
                    "value": "exists"
                }
            ]
        }
    ]
}
