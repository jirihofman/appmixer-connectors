{
    "name": "appmixer.redis.core.DeleteKey",
    "description": "Deletes one or more keys.",
    "author": "Appmixer <info@appmixer.com>",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:redis"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    }
                },
                "required": [
                    "key"
                ]
            },
            "inspector": {
                "inputs": {
                    "key": {
                        "type": "text",
                        "label": "Key",
                        "index": 1,
                        "tooltip": "The key to delete (comma-separated for multiple keys)."
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                {
                    "label": "Deleted Count",
                    "value": "deletedCount"
                },
                {
                    "label": "Keys",
                    "value": "keys"
                }
            ]
        }
    ]
}
