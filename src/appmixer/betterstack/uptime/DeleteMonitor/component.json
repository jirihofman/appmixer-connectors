{
    "name": "appmixer.betterstack.uptime.DeleteMonitor",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Delete a monitor from Better Stack Uptime.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "monitorId": {
                        "type": "string"
                    }
                },
                "required": ["monitorId"]
            },
            "inspector": {
                "inputs": {
                    "monitorId": {
                        "type": "text",
                        "label": "Monitor ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the monitor to delete"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
