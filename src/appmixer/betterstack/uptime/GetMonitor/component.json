{
    "name": "appmixer.betterstack.uptime.GetMonitor",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a specific monitor by its ID from Better Stack Uptime.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "monitorId": {
                        "type": "string"
                    }
                },
                "required": ["monitorId"]
            },
            "inspector": {
                "inputs": {
                    "monitorId": {
                        "type": "text",
                        "label": "Monitor ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the monitor"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Monitor ID", "value": "id" },
                { "label": "Monitor Type", "value": "type" },
                { "label": "URL", "value": "url" },
                { "label": "Pronounceable Name", "value": "pronounceable_name" },
                { "label": "Status", "value": "status" },
                { "label": "Check Frequency", "value": "check_frequency" },
                { "label": "Created At", "value": "created_at" },
                { "label": "Updated At", "value": "updated_at" },
                { "label": "Last Checked At", "value": "last_checked_at" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
