{
    "name": "appmixer.betterstack.uptime.UpdateIncident",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an incident in Better Stack Uptime (e.g., acknowledge or resolve).",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "incidentId": {
                        "type": "string"
                    },
                    "requester_email": {
                        "type": "string"
                    }
                },
                "required": ["incidentId"]
            },
            "inspector": {
                "inputs": {
                    "incidentId": {
                        "type": "text",
                        "label": "Incident ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the incident to update"
                    },
                    "requester_email": {
                        "type": "text",
                        "label": "Requester Email",
                        "index": 2,
                        "tooltip": "Email address of the person acknowledging the incident"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
