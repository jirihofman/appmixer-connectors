{
    "name": "appmixer.betterstack.uptime.UpdateMonitor",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Update an existing monitor in Better Stack Uptime.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "monitorId": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "pronounceable_name": {
                        "type": "string"
                    },
                    "check_frequency": {
                        "type": "integer"
                    },
                    "call": {
                        "type": "boolean"
                    },
                    "sms": {
                        "type": "boolean"
                    },
                    "email": {
                        "type": "boolean"
                    },
                    "push": {
                        "type": "boolean"
                    },
                    "paused": {
                        "type": "boolean"
                    }
                },
                "required": ["monitorId"]
            },
            "inspector": {
                "inputs": {
                    "monitorId": {
                        "type": "text",
                        "label": "Monitor ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the monitor to update"
                    },
                    "url": {
                        "type": "text",
                        "label": "URL",
                        "index": 2,
                        "tooltip": "The URL to monitor"
                    },
                    "pronounceable_name": {
                        "type": "text",
                        "label": "Monitor Name",
                        "index": 3,
                        "tooltip": "Human-readable name for the monitor"
                    },
                    "check_frequency": {
                        "type": "number",
                        "label": "Check Frequency (seconds)",
                        "index": 4,
                        "tooltip": "How often to check the monitor in seconds"
                    },
                    "call": {
                        "type": "toggle",
                        "label": "Phone Call Alerts",
                        "index": 5,
                        "tooltip": "Enable phone call notifications"
                    },
                    "sms": {
                        "type": "toggle",
                        "label": "SMS Alerts",
                        "index": 6,
                        "tooltip": "Enable SMS notifications"
                    },
                    "email": {
                        "type": "toggle",
                        "label": "Email Alerts",
                        "index": 7,
                        "tooltip": "Enable email notifications"
                    },
                    "push": {
                        "type": "toggle",
                        "label": "Push Notifications",
                        "index": 8,
                        "tooltip": "Enable push notifications"
                    },
                    "paused": {
                        "type": "toggle",
                        "label": "Paused",
                        "index": 9,
                        "tooltip": "Pause or resume the monitor"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out"
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
