{
    "name": "appmixer.betterstack.uptime.GetIncident",
    "author": "Appmixer <info@appmixer.com>",
    "description": "Retrieve a specific incident by its ID from Better Stack Uptime.",
    "version": "1.0.0",
    "auth": {
        "service": "appmixer:betterstack"
    },
    "quota": {
        "manager": "appmixer:betterstack",
        "resources": "requests",
        "scope": {
            "userId": "{{userId}}"
        }
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "incidentId": {
                        "type": "string"
                    }
                },
                "required": ["incidentId"]
            },
            "inspector": {
                "inputs": {
                    "incidentId": {
                        "type": "text",
                        "label": "Incident ID",
                        "index": 1,
                        "tooltip": "The unique identifier of the incident"
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Incident ID", "value": "id" },
                { "label": "Type", "value": "type" },
                { "label": "Name", "value": "name" },
                { "label": "Cause", "value": "cause" },
                { "label": "Started At", "value": "started_at" },
                { "label": "Resolved At", "value": "resolved_at" },
                { "label": "Acknowledged At", "value": "acknowledged_at" },
                { "label": "Response Time", "value": "response_time" },
                { "label": "Response Status", "value": "response_status" }
            ]
        }
    ],
    "icon": "data:image/svg+xml;base64,"
}
